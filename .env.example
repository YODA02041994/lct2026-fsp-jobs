# Скопируйте в .env и заполните. Без SMTP и внешней модели сервис работает в демонстрационном режиме.
FSP_DATABASE_URL=sqlite:///./data/fsp.db
FSP_SECRET_KEY=замените-на-длинную-случайную-строку
FSP_PUBLIC_URL=http://localhost:8000
FSP_ROOT_PATH=
# почта (пусто — ссылка подтверждения показывается на экране)
FSP_SMTP_HOST=
FSP_SMTP_PORT=587
FSP_SMTP_USER=
FSP_SMTP_PASSWORD=
FSP_SMTP_FROM=noreply@example.org
# внешняя модель, OpenAI-совместимая (пусто — правила)
FSP_LLM_BASE_URL=
FSP_LLM_API_KEY=
FSP_LLM_MODEL=
# тест
FSP_TEST_BLOCK_SIZE=5
FSP_TEST_BLOCKS=2
FSP_TEST_ITEM_SECONDS=90
FSP_GRADE_CHANGE_COOLDOWN_DAYS=90
# ФСП ID (OpenID Connect); пусто — встроенный издатель-заглушка
FSP_FSP_OIDC_ISSUER=
FSP_FSP_OIDC_CLIENT_ID=
FSP_FSP_OIDC_CLIENT_SECRET=
